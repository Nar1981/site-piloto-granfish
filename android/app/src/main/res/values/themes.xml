<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.GranFish" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/copper</item>
        <item name="colorSecondaryVariant">@color/copper</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

    <!-- Splash Screen theme -->
    <style name="Theme.GranFish.Splash" parent="Theme.GranFish">
        <item name="android:windowBackground">@drawable/splash_bg</item>
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
    </style>

    <!-- Dialog theme -->
    <style name="Theme.GranFish.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/copper</item>
        <item name="colorSecondary">@color/teal</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">#a9c4c0</item>
        <item name="buttonBarPositiveButtonStyle">@style/GranFish.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/GranFish.Dialog.Button</item>
    </style>

    <style name="GranFish.Dialog.Button" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/copper</item>
    </style>
</resources>
